# Copy to .env.local. The Next app, the worker and the scripts all read it.
APP_URL=http://localhost:3000

# ---- Database (DigitalOcean Managed PostgreSQL in production, docker compose locally) ----
DATABASE_URL=postgresql://visualise:visualise@127.0.0.1:5432/visualise
# Production: paste the connection string from the DO control panel (ends in ?sslmode=require) and the
# cluster CA certificate so TLS is verified. DATABASE_SSL=no-verify is for throwaway environments only.
# DATABASE_URL=postgresql://doadmin:...@db-postgresql-blr1-xxxxx.l.db.ondigitalocean.com:25060/visualise?sslmode=require
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_SSL=off
DATABASE_POOL_MAX=8

# ---- Object storage: DigitalOcean Spaces (S3 API). Unset locally = files under .data/uploads ----
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_KEY=
SPACES_SECRET=

# ---- Google sign-in. Unset locally = the Google button signs in a local test parent ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorised redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (Resend): sign-in links and the daily parent report. Unset locally = written to .data/last-email.txt ----
RESEND_API_KEY=
MAIL_FROM="ExplainCanvas <hello@explaincanvas.com>"
SUPPORT_EMAIL=hello@explaincanvas.com
SESSION_TTL_DAYS=30

# ---- Claude ----
ANTHROPIC_API_KEY=
TEACHING_MODEL=claude-opus-5-5
VERIFY_MODEL=claude-opus-5-5
ROUTER_MODEL=claude-haiku-5-5
FOLLOWUP_MODEL=claude-haiku-5-5
FOLLOWUP_ESCALATION_MODEL=claude-sonnet-5-5

# ---- Media: fal.ai is the default for video, illustrations and premium voice (one key, model ids are config) ----
# https://fal.ai/dashboard/keys . Check https://fal.ai/models for current ids if a default changes.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=fal-ai/veo3.1/lite
FAL_VIDEO_MODEL_FAST=fal-ai/veo3.1/fast
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/turbo-v2.5
FAL_TTS_VOICE=Rachel
FAL_STT_MODEL=fal-ai/whisper

# ---- Google Gemini direct, only used for images/video when FAL_KEY is not set (optional) ----
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVEN_LABS_MODEL=eleven_turbo_v2_5
ELEVEN_LABS_PREMIUM_MODEL=eleven_multilingual_v2
GEMINI_API_KEY=
IMAGE_MODEL=imagen-4.0-generate-001
VIDEO_MODEL=veo-3.1-lite-generate-preview
VIDEO_MODEL_FAST=veo-3.1-fast-generate-preview

# Hour of day (IST) when the daily parent report email goes out
PARENT_REPORT_HOUR_IST=20

# Which formats the router may choose. diagram, steps, slides, three_d, annotation and animation need no media keys.
# Add video once FAL_KEY (or GEMINI_API_KEY) is set.
ENABLE_FORMATS=diagram,steps,slides,three_d,annotation,animation

# Development runs the pipeline inside the Next process right after enqueue. Set false in production and run the worker service.
RUN_PIPELINE_INLINE=true

# ---- Dodo Payments. Unset locally = mock checkout with a dev-only confirm route ----
# Dashboard: Developer > API Keys (DODO_API_KEY), Developer > Webhooks > endpoint > signing secret (whsec_...).
# Product ids are per mode: create the catalogue in test mode too if you want to test, or go straight to live.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_MODE=live
DODO_PRODUCT_STUDENT=pdt_0NqQcdwu9weKAwpwpFHkh
DODO_PRODUCT_PRO=pdt_0NqQckuPby0DwqXNJ1jyM
DODO_PRODUCT_MAX=pdt_0NqQcrW65ttQpn4Uyy7iX
DODO_PRODUCT_MAX_ANNUAL=pdt_0NqQczxrFRV3W2zyFfpJM
DODO_PRODUCT_TOPUP_SMALL=pdt_0NqQd7lH0Mi5wPrPnHxsf
DODO_PRODUCT_TOPUP_MEDIUM=pdt_0NqQdCVuIGr61nxa29APS
DODO_PRODUCT_TOPUP_LARGE=pdt_0NqQdJ9eR9KjjZwSzOJOJ

LOG_LEVEL=info

# Who can open /admin (comma-separated emails)
ADMIN_EMAILS=parthajy@gmail.com
