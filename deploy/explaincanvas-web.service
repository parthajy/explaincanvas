[Unit]
Description=ExplainCanvas web (Next.js)
After=network.target

[Service]
Type=simple
User=app
WorkingDirectory=/srv/explaincanvas
EnvironmentFile=/srv/explaincanvas/.env.production
Environment=NODE_ENV=production PORT=3000
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
